rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every visitor signs in anonymously when the app opens; only signed-in visitors can read or write.
    // The group code and admin code are checked inside the app.
    match /trainings/{id} {
      allow read, write: if request.auth != null;
    }
    match /meta/settings {
      allow read, write: if request.auth != null;
    }
  }
}
